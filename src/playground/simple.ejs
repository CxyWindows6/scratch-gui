<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= htmlWebpackPlugin.options.title %></title>
    <style>
      body[data-splash-theme="dark"] {
        background: #111;
      }

      noscript {
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      }
    </style>
  </head>
  <body>
    <noscript>
      <h1>This page requires JavaScript</h1>
    </noscript>

    <script>
      (function() {
        var theme = '';

        // Surge Editor (mdui): the splash theme follows the mdui theme mode,
        // which itself defaults to the system preference. The legacy
        // scratch-gui GUI theme was retired.
        try {
          var mduiTheme = localStorage.getItem('surge:mdui-theme');
          if (mduiTheme === 'light' || mduiTheme === 'dark') {
            theme = mduiTheme;
          }
        } catch (e) {
          // ignore
        }

        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        document.body.setAttribute('data-splash-theme', theme);
      })();
    </script>

    <div id="app"></div>
  </body>
</html>
